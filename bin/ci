#!/usr/bin/env bash
# Copyright (c) Joseph Hale, 2026
# SPDX-License-Identifier: MPL-2.0

set -euo pipefail

# shellcheck source=bin/lib/colors
source "$(dirname "${BASH_SOURCE[0]}")/lib/colors"
# shellcheck source=bin/lib/filelike
source "$(dirname "${BASH_SOURCE[0]}")/lib/filelike"

results=""

function main() {
	local started
	started="$(timestamp)"

	if [[ "${1:-}" == "--fix" ]]; then
		check "Bash: Shebang" "filelike bash | bin/shebang --fix '#!/usr/bin/env bash'"
		check "Bash: Format" "filelike bash | xargs shfmt --write"
		check "YAML: Format" "bin/yamlformat --fix"
		check "Markdown: Lint" "bin/markdownlint --fix"
		check "License" "bin/lawyer --fix"
	else
		check "Bash: Shebang" "filelike bash | bin/shebang '#!/usr/bin/env bash'"
		check "Bash: Syntax" "filelike bash | xargs -n1 bash -n"
		check "Bash: Lint" "filelike bash | xargs shellcheck --external-sources"
		check "Bash: Format" "filelike bash | xargs shfmt --diff"
		check "Bash: Test" "bats --recursive bin"
		check "Actions: Lint" "actionlint"
		check "Actions: Audit" "zizmor --quiet .github"
		check "YAML: Format" "bin/yamlformat"
		check "Markdown: Lint" "bin/markdownlint"
		check "License" "bin/lawyer"
	fi

	summarize "$(elapsed "$started")"
}

function check() {
	local exit_code=0
	local name="$1"
	local cmd="$2"

	local started
	started="$(timestamp)"

	echo -e "\n$(yellow "==>") $(blue "$name") $(grey "$cmd")\n"
	set +e
	(eval "$cmd")
	exit_code=$?
	set -e

	local outcome
	if [ "$exit_code" -ne 0 ]; then
		outcome="$(red "FAIL")"
	else
		outcome="$(green "PASS")"
	fi
	results+="$outcome $exit_code $(blue "$name") $(grey "$cmd") ($(elapsed "$started"))\n"
}

# Microseconds since the epoch
function timestamp() {
	local now="$EPOCHREALTIME"
	echo "${now//[.,]/}"
}

function elapsed() {
	local micros=$(($(timestamp) - $1))
	printf '%d.%02ds\n' "$((micros / 1000000))" "$((micros % 1000000 / 10000))"
}

function summarize() {
	local total="$1"

	echo -e "\n$(yellow "==> Summary <==")\n\n$results$(yellow "TOTAL") ($total)\n"
	if [[ "$results" == *"FAIL"* ]]; then
		echo "Some checks failed. Please review the summary above."
		exit 1
	else
		echo "All checks passed successfully!"
		exit 0
	fi
}

main "$@"
