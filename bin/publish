#!/usr/bin/env bash
# Copyright (c) Joseph Hale, 2026
# SPDX-License-Identifier: MPL-2.0
#
# Usage: bin/publish [--dry-run]

set -euo pipefail

# shellcheck source=bin/lib/colors
source "$(dirname "${BASH_SOURCE[0]}")/lib/colors"

BRANCH="main"
RELEASE_TAG="^v[0-9]+\.[0-9]+\.[0-9]+$"
DRY_RUN="no"

main() {
	refuse_automation
	confirm_arguments "$@"
	confirm_checks
	confirm_branch
	confirm_clean_tree
	confirm_release_tag
	confirm_declared_module
	confirm_pushed_branch
	confirm_remote_tag
	confirm_github_access
	publish
}

refuse_automation() {
	if [[ -n "${CI:-}" ]]; then
		refuse "CI publishes nothing. Run bin/publish from a workstation."
	fi
}

refuse() {
	red "$1" >&2

	if [[ $# -gt 1 ]]; then
		echo >&2
		blue "    $2" >&2
		echo >&2
	fi

	exit 1
}

confirm_arguments() {
	if [[ $# -eq 1 && "$1" == "--dry-run" ]]; then
		DRY_RUN="yes"
	elif [[ $# -gt 0 ]]; then
		refuse "The only argument this takes is --dry-run. Usage: bin/publish [--dry-run]" \
			"bin/publish --dry-run"
	fi
}

confirm_checks() {
	if ! bin/ci; then
		refuse "bin/ci failed. A release is cut from a checkout that passes." \
			"bin/ci --fix  # NOTE: not every problem is autofixable"
	fi
}

confirm_branch() {
	local branch
	branch="$(git rev-parse --abbrev-ref HEAD)"

	if [[ "$branch" != "$BRANCH" ]]; then
		refuse "On $branch. A release is published from $BRANCH." \
			"git switch $BRANCH"
	fi
}

confirm_clean_tree() {
	if [[ -n "$(git status --porcelain)" ]]; then
		refuse "The working tree has changes. Commit them or put them aside." \
			"git add . && git stash"
	fi
}

confirm_release_tag() {
	if [[ -z "$(release_tag)" ]]; then
		refuse "HEAD carries no vX.Y.Z tag. Tag the commit you mean to release." \
			"git tag vX.Y.Z"
	fi
}

release_tag() {
	git tag --points-at HEAD | grep --extended-regexp "$RELEASE_TAG" | head --lines 1 || true
}

confirm_declared_module() {
	local declared serving
	declared="$(module_path)"
	serving="$(origin_path)"

	if [[ "$declared" != "$serving" ]]; then
		refuse "go.mod declares $declared, but origin serves $serving. go install would fetch somebody else's code." \
			"go mod edit -module $serving"
	fi
}

module_path() {
	sed --quiet --regexp-extended 's%^module (.*)$%\1%p' go.mod
}

origin_path() {
	local url
	url="$(git remote get-url origin)"
	url="${url%.git}"
	url="${url#*://}"
	echo "${url#*@}" | tr ':' '/'
}

confirm_pushed_branch() {
	local pushed
	pushed="$(remote_object "refs/heads/$BRANCH")"

	if [[ -z "$pushed" ]]; then
		refuse "origin has no $BRANCH. A release nobody can fetch is not a release." \
			"git push origin $BRANCH"
	fi

	if [[ "$pushed" != "$(git rev-parse "HEAD^{}")" ]]; then
		refuse "origin/$BRANCH is a different commit. Send $BRANCH there first." \
			"git push origin $BRANCH"
	fi
}

remote_object() {
	git ls-remote origin "$1" | cut --fields 1 | tail --lines 1
}

confirm_remote_tag() {
	local tag pushed
	tag="$(release_tag)"
	pushed="$(remote_object "refs/tags/$tag")"

	if [[ -n "$pushed" && "$pushed" != "$(git rev-parse "refs/tags/$tag")" ]]; then
		refuse "origin already carries a different $tag. Reconcile them by hand." \
			"git ls-remote origin refs/tags/$tag"
	fi
}

confirm_github_access() {
	if [[ -z "${GITHUB_TOKEN:-}" ]] && ! gh auth status &>/dev/null; then
		refuse "Nothing here can reach GitHub, and that is where the binaries go." \
			"gh auth login"
	fi
}

publish() {
	local tag
	tag="$(release_tag)"

	if [[ "$DRY_RUN" == "yes" ]]; then
		rehearse "$tag"
	else
		perform "$tag"
	fi
}

rehearse() {
	yellow "Rehearsing the release of $1"
	git push --dry-run origin "refs/tags/$1"
	goreleaser release --clean --skip=publish
	green "Rehearsed $1. Run bin/publish to publish it."
}

perform() {
	yellow "Releasing $1"
	git push origin "refs/tags/$1"
	GITHUB_TOKEN="${GITHUB_TOKEN:-$(gh auth token)}" goreleaser release --clean
	green "Published $1"
}

main "$@"
