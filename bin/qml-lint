#!/usr/bin/env bash
# Copyright (c) 2026 Joseph Hale
# SPDX-License-Identifier: MPL-2.0

# Usage: filelike qml | bin/qml-lint [--fix]

set -euo pipefail

# `disable`s exist to ignore the `qs.*` modules Quickshell supplies at runtime.
LINT=(pyside6-qmllint --import disable --unqualified disable --max-warnings 0)

main() {
	local files=()
	local file
	while IFS= read -r file; do
		files+=("$file")
	done
	((${#files[@]})) || return 0

	if [[ "${1:-}" == "--fix" ]]; then
		"${LINT[@]}" --fix "${files[@]}"
	else
		"${LINT[@]}" "${files[@]}"
	fi
}

main "$@"
