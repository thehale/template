#!/usr/bin/env bash
# Copyright (c) Joseph Hale, 2026
# SPDX-License-Identifier: MPL-2.0

set -euo pipefail

if ! command -v mise &>/dev/null; then
	echo "Installing mise..."
	curl https://mise.run | sh
fi

mise trust
MISE_LOCKED_SCOPES=project mise install --locked

bin/add-git-hooks
bin/link-agent-config
